{
  "files.eol": "\n",
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/generated/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/generated": true
  },
  "java.compile.nullAnalysis.mode": "automatic",
  "java.configuration.updateBuildConfiguration": "interactive"
}
