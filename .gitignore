# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Repo-root ignores are GLOBAL (repo-wide). Package build artifacts live in
# the nested .gitignore files: client/.gitignore (node_modules) and
# client/web/.gitignore (.next, generated, .swc, coverage).

# dependencies (unanchored net — client/.gitignore owns the workspace copy)
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.production.local
.env.development
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
