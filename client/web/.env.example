# Base URL for local dev
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The Java API, which owns sign-in. Both fall back to the local server
# (http://localhost:8080, cookie circadium_access) outside a production build
# and must be set in one. Staging: https://api.staging.circadium.app and
# __Secure-circadium_staging_access; prod: https://api.circadium.app and
# __Secure-circadium_access.
# NEXT_PUBLIC_API_URL=""
# AUTH_ACCESS_COOKIE=""

# The sign-in buttons to show, comma-separated (all of google,microsoft,apple
# when unset). Must name the same providers as the API's OAUTH_PROVIDERS. A
# local API without a provider's credentials refuses its button.
# NEXT_PUBLIC_OAUTH_PROVIDERS="google"

# "on" opens a WebSocket to the Java API so an edit in one session appears in
# the user's other sessions without a reload; unset keeps the HTTP sync loop as
# the only channel (exactly today).
# Inlined at build time.
NEXT_PUBLIC_CALENDAR_REALTIME="on"

# Dev DB connection info
DATABASE_URL=""

# Google OAuth client for Google Calendar import (Google sign-in is configured
# on the Java API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Microsoft Graph calendar import (optional; Entra app registration, common tenant)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

RESEND_API_KEY=""

# PostHog analytics (EU cloud), proxied through /relay-cq. Leave empty to
# disable analytics entirely (no requests, no init). Erasing a deleted
# account's analytics person is done by the Java API.
NEXT_PUBLIC_POSTHOG_KEY=""
