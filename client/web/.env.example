# Base URL for local dev
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The Java API, which owns sign-in. Both fall back to the local server
# (http://localhost:8080, cookie circadium_access) outside a production build
# and must be set in one. Staging: https://api.staging.circadium.app and
# circadium_staging_access.
# NEXT_PUBLIC_API_URL=""
# AUTH_ACCESS_COOKIE=""

# Dev DB connection info
DATABASE_URL=""

# Google OAuth client for Google Calendar import (Google sign-in is configured
# on the Java API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps/Places API for location and travel time features
GOOGLE_MAPS_API_KEY=""

# Microsoft Graph calendar import (optional; Entra app registration, common tenant)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

RESEND_API_KEY=""

# PostHog analytics (EU cloud), proxied through /relay-cq. Leave empty to
# disable analytics entirely (no requests, no init). Erasing a deleted
# account's analytics person is done by the Java API.
NEXT_PUBLIC_POSTHOG_KEY=""
