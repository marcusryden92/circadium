model ExternalCalendarSource {
  id             String               @id @default(uuid())
  userId         String
  kind           ExternalCalendarKind
  url            String
  name           String
  color          String?
  enabled        Boolean              @default(true)
  mode           ExternalCalendarMode @default(BUSY)
  modeExceptions String? // JSON string[] of provider event UIDs whose busy/visual behavior flips the source default
  lastFetchedAt  DateTime?
  lastError      String? // Human-readable fetch/parse failure, cleared on the next successful refresh
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ExternalEvent[]

  @@index([userId])
  @@map("ExternalCalendarSources")
}

model ExternalEvent {
  id       String                 @id // `${sourceId}|${uid}|${occurrenceStartISO}` — deterministic, CategoryEvent pattern
  sourceId String
  userId   String
  uid      String // Provider event UID (series-level for recurring events) — the modeExceptions key
  title    String
  start    String
  end      String
  allDay   Boolean                @default(false)
  source   ExternalCalendarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceId])
  @@map("ExternalEvents")
}

// One per user: the offline grant for Google Calendar API access (BYO Google
// account, independent of the login provider so credentials users can connect
// too). The refresh token is exchanged for short-lived access tokens per
// fetch; revoked + deleted on disconnect.
model GoogleCalendarConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  email        String? // Google account email, display only
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("GoogleCalendarConnections")
}

// One per user: the offline grant for Microsoft Graph calendar access (BYO
// Microsoft account, independent of the login provider). Unlike Google,
// Microsoft ROTATES refresh tokens — every token refresh returns a new one,
// which must be persisted immediately. There is also no programmatic revoke
// for consumer grants: disconnect deletes the local copy and points the user
// at their Microsoft account's app permissions.
model MicrosoftCalendarConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  email        String? // Microsoft account email, display only
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("MicrosoftCalendarConnections")
}

enum ExternalCalendarKind {
  ICS
  GOOGLE
  MICROSOFT
}

enum ExternalCalendarMode {
  BUSY
  VISUAL
}
